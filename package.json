{
  "name": "school-cloud-system",
  "version": "1.7.0",
  "private": true,
  "description": "School Cloud System (powered by Petgabs) — public library of classroom resources",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i assets/css/tailwind.src.css -o assets/css/app.css --minify",
    "watch:css": "tailwindcss -i assets/css/tailwind.src.css -o assets/css/app.css --watch",
    "vendor": "node scripts/vendor.mjs",
    "build": "npm run vendor && npm run build:css",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:js": "node scripts/syntax-check.mjs",
    "dev": "node scripts/dev-server.mjs"
  },
  "devDependencies": {
    "alpinejs": "^3.14.9",
    "axe-core": "^4.10.2",
    "jsdom": "^25.0.1",
    "lucide": "^0.469.0",
    "tailwindcss": "^3.4.17",
    "vitest": "^5.0.3"
  }
}
